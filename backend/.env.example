# Database — PostgreSQL with pgvector extension
DATABASE_URL=postgresql://user:password@localhost:5432/kindred

# Flickr API credentials (get from https://www.flickr.com/services/api/keys/)
FLICKR_API_KEY=
FLICKR_SECRET=
FLICKR_OAUTH_TOKEN=
FLICKR_OAUTH_SECRET=
FLICKR_USER_ID=

# API key for authenticating frontend/mobile requests
API_KEY=

# Secret for scan endpoint authentication
SCAN_SECRET=

# Optional App Store reviewer login. When both values are set, this credential
# opens the app's bundled sample library and receives no private API access.
APP_REVIEW_USERNAME=appreview@kindredphotos.app
APP_REVIEW_PASSWORD=

# iCloud library download (COMPOSE_PROFILES=public,icloud).
# No password or 2FA code belongs here. Establish the session once by hand:
#   docker run --rm -it --entrypoint /opt/icloudpd/bin/icloudpd \
#     -v "$ICLOUD_COOKIE_DIR":/config boredazfcuk/icloudpd:1.0.1380_06-09-2026 \
#     --username "$ICLOUD_USERNAME" --cookie-directory /config --auth-only
# The service then reuses that cookie until 2FA expires.
ICLOUD_USERNAME=you@example.com
ICLOUD_COOKIE_DIR=/volume1/docker/kindred-icloud/michael/config
