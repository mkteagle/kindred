# Database — PostgreSQL with pgvector extension
DATABASE_URL=postgresql://user:password@localhost:5432/kindred

# Flickr API credentials (get from https://www.flickr.com/services/api/keys/)
FLICKR_API_KEY=
FLICKR_SECRET=
FLICKR_OAUTH_TOKEN=
FLICKR_OAUTH_SECRET=
FLICKR_USER_ID=

# API key for authenticating frontend/mobile requests
API_KEY=

# Secret for scan endpoint authentication
SCAN_SECRET=

# Optional App Store reviewer login. When both values are set, this credential
# opens the app's bundled sample library and receives no private API access.
APP_REVIEW_USERNAME=appreview@kindredphotos.app
APP_REVIEW_PASSWORD=

# iCloud libraries (COMPOSE_PROFILES=public,icloud).
# No password or 2FA code belongs here. Establish each person's session once,
# by hand, on a console -- they type their own password and code:
#
#   docker run --rm -it --entrypoint /opt/icloudpd/bin/icloudpd \
#     -v <their cookie dir>:/config boredazfcuk/icloudpd:1.0.1380_06-09-2026 \
#     --username <their apple id> --cookie-directory /config --auth-only
#
# The services then reuse that cookie until 2FA expires, typically a month.
ICLOUD_USERNAME_MICHAEL=you@example.com
ICLOUD_COOKIES_MICHAEL=/volume1/docker/kindred-icloud/michael/config
ICLOUD_USERNAME_WIFE=her@example.com
ICLOUD_COOKIES_WIFE=/volume1/docker/kindred-icloud/wife/config
ICLOUD_USERNAME_MADISON=them@example.com
ICLOUD_COOKIES_MADISON=/volume1/docker/kindred-icloud-madison/madison/config
