# Copy to .env inside the UGREEN Docker Project folder. Never commit .env.
POSTGRES_DB=kindred
POSTGRES_USER=kindred
POSTGRES_PASSWORD=replace-with-a-long-random-password

API_KEY=replace-with-a-long-random-secret
SCAN_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-a-long-random-secret

PUBLIC_WEB_URL=https://nas.kindredphotos.app
CORS_ORIGINS=https://kindredphotos.app,https://nas.kindredphotos.app
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-named-tunnel-token
# Set this only when the public Cloudflare connector should run.
COMPOSE_PROFILES=public

FLICKR_API_KEY=
FLICKR_SECRET=
FLICKR_OAUTH_TOKEN=
FLICKR_OAUTH_SECRET=
FLICKR_USER_ID=

# Isolated App Store reviewer login. This opens bundled sample data only and
# never creates a database user or grants access to the household library.
APP_REVIEW_USERNAME=appreview@kindredphotos.app
APP_REVIEW_PASSWORD=replace-with-a-long-random-password

# Optional integrations
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kindred Photos <noreply@kindredphotos.app>
NEXT_PUBLIC_POSTHOG_KEY=
