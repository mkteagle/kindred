# Backend URL — your self-hosted Kindred API
BACKEND_URL=http://localhost:8000

# API key — must match the API_KEY in backend/.env
API_KEY=

# Cookie encryption secret — generate with: openssl rand -hex 32
COOKIE_SECRET=

# PostHog analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=

# Resend email (optional — enables invite emails)
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kindred Photos <noreply@kindredphotos.app>

# Public app URL for invite links
NEXT_PUBLIC_APP_URL=https://kindredphotos.app
