<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Kindred ships dark first. The activity draws edge to edge, so the bars
      are transparent and Compose paints underneath them; the window
      background matters only for the frame before the first composition.
    -->
    <style name="Theme.Kindred" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/kindred_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.Kindred.Splash" parent="Theme.Kindred">
        <item name="android:windowBackground">@color/kindred_bg</item>
    </style>

</resources>
